# Database
DATABASE_URL=postgresql://readme:readme@localhost:5433/readme

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3100

# GitHub OAuth — create an OAuth app at https://github.com/settings/developers
# Callback URL: http://localhost:3100/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Magic link email (SMTP). Leave EMAIL_SERVER empty in dev to have the
# magic link printed to the server console instead of sent.
# Format: smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=
EMAIL_FROM=readme <no-reply@localhost>
